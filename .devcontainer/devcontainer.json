{
  "name": "Studio",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Studio",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install -e \".[dev]\"",
  "postStartCommand": "bash -lc 'STUDIO_HOST=0.0.0.0 STUDIO_PORT=8000 nohup studio > /tmp/studio.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
